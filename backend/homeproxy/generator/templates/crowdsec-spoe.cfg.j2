# Generated by HomeProxy. Do not edit: the next apply replaces this file.
# SPOE config for the CrowdSec SPOA bouncer, adapted from the crowdsec.cfg it ships. Its
# `crowdsec-tcp` message is sent as a group by the TCP frontends, after the real client is known.
# Its `on-client-session` event is left out: it fires before then, so on fe_https it would check
# Cloudflare's edge instead of the visitor.
[crowdsec]
spoe-agent crowdsec-agent
    groups {% if crowdsec_body %}crowdsec-http-body {% endif %}crowdsec-http-no-body crowdsec-tcp
    option var-prefix crowdsec
    # An error sets txn.crowdsec.error and leaves no remediation, so the request goes through.
    option set-on-error error
    timeout hello 200ms
    timeout idle 55s
    timeout processing 500ms
    use-backend crowdsec-spoa
    # No `log`: an SPOE line per request would reach CrowdSec beside the access line.

# The bouncer knows these message names.
{% if crowdsec_body %}
# The body carries captcha answers, and AppSec inspects it.
spoe-message crowdsec-http-body
    args method=method path=path query=query version=req.ver headers=req.hdrs body=req.body url=url ssl=ssl_fc src-ip=src src-port=src_port

{% endif %}
spoe-message crowdsec-http-no-body
    args method=method path=path query=query version=req.ver headers=req.hdrs url=url ssl=ssl_fc src-ip=src src-port=src_port

spoe-message crowdsec-tcp
    args src-ip=src src-port=src_port
{% if crowdsec_body %}

spoe-group crowdsec-http-body
    messages crowdsec-http-body
{% endif %}

spoe-group crowdsec-http-no-body
    messages crowdsec-http-no-body

spoe-group crowdsec-tcp
    messages crowdsec-tcp
