# Generated by HomeProxy. Do not edit: the next apply replaces this file.
backend be_not_found
    http-request deny deny_status 404
{% for backend in backends %}

backend {{ backend.name | token }}
{% if backend.users %}
    http-request auth unless { http_auth({{ backend.name | token }}) }
    # The upstream never gets the HomeProxy credentials. A route request header may set its own.
    http-request del-header Authorization
{% endif %}
{% if backend.strip_prefix is not none %}
    # The frontend matched the decoded path. A path that spells the prefix another way cannot be cut.
    http-request deny deny_status 400 unless { path {{ backend.strip_prefix | path_prefix }} } || { path_beg {{ backend.strip_prefix | path_prefix }}/ }
    http-request set-path /%[path,bytes({{ (backend.strip_prefix | length + 1) | number }})]
{% endif %}
{% if backend.websocket %}
    timeout tunnel 1h
{% endif %}
{% if backend.check_path is not none %}
    option httpchk
    http-check send meth GET uri {{ backend.check_path | quoted }} ver HTTP/1.1 hdr Host {{ backend.check_host | token }}
{% endif %}
{% for name, value in backend.request_headers %}
    http-request set-header {{ name | token }} {{ value | quoted_log_format }}
{% endfor %}
{% for name, value in backend.response_headers %}
    http-response set-header {{ name | token }} {{ value | quoted_log_format }}
{% endfor %}
{% for server in backend.servers %}
{% if server.tls_name is none %}
    server {{ server.address | token }} {{ server.address | token }} check inter {{ backend.check_interval | token }}
{% elif backend.tls_verify %}
    server {{ server.address | token }} {{ server.address | token }} check inter {{ backend.check_interval | token }} ssl verify required ca-file @system-ca verifyhost {{ server.tls_name | token }} sni str({{ server.tls_name | token }}) check-sni {{ server.tls_name | token }}
{% else %}
    server {{ server.address | token }} {{ server.address | token }} check inter {{ backend.check_interval | token }} ssl verify none sni str({{ server.tls_name | token }}) check-sni {{ server.tls_name | token }}
{% endif %}
{% endfor %}
{% endfor %}
{% for backend in stream_backends %}

backend {{ backend.name | token }} from tcp
{% for server in backend.servers %}
    server {{ server | token }} {{ server | token }} check inter {{ tcp_check_interval | token }}
{% endfor %}
{% endfor %}
