#!/usr/bin/env bash
#MISE description="Backend: ruff, ruff format, mypy strict, pytest"
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?}/backend"
uv sync --frozen
uv run --frozen ruff check .
uv run --frozen ruff format --check .
uv run --frozen mypy
# One worker per core. Work stealing keeps the workers busy when a few tests start containers.
uv run --frozen pytest -n auto --dist worksteal
